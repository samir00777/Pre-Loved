# PreLoved Environment Configuration Example
SECRET_KEY=your-secret-key-here
DEBUG=True

# Gmail SMTP Email Configuration
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_google_app_password
